# =====================================================================
# EAES Exam System — root .htaccess
# =====================================================================

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # CRITICAL: Tell Apache your app lives in this subfolder
    RewriteBase /eaes_exam_system/

    # Block sensitive folders
    RewriteRule ^app/ - [F,L]
    RewriteRule ^storage/ - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^partials/ - [F,L]
    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^\.env\.example$ - [F,L]
</IfModule>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# THIS IS THE FIX: No <Directory> tag allowed here!
# Using FilesMatch instead (completely legal in .htaccess)
<IfModule mod_php.c>
    <FilesMatch "assets/.*\.php$">
        php_flag engine off
    </FilesMatch>
</IfModule>